---
import PageLayout from '@layouts/PageLayout.astro';
import Breadcrumbs from '@components/common/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { locales, t, type Locale } from '@i18n/utils';
import { formatDate } from '@utils/seo';
import { formatReadingTime, getReadingTime } from '@utils/reading-time';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };

const allPosts = await getCollection('blog', ({ slug, data }) => {
  return slug.startsWith(`${lang}/`) && !data.draft;
});

const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const breadcrumbs = [{ label: t(lang, 'nav.blog'), href: `/${lang}/blog/` }];
---

<PageLayout title={t(lang, 'nav.blog')}>
  <div class="container-custom py-10">
    <Breadcrumbs lang={lang} items={breadcrumbs} />

    <h1 class="text-4xl font-extrabold text-surface-900 dark:text-surface-50 mb-2">
      {t(lang, 'nav.blog')}
    </h1>
    <p class="text-surface-600 dark:text-surface-400 mb-10">
      {t(lang, 'site.description')}
    </p>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {sortedPosts.map((post) => {
        const readingTime = post.body ? getReadingTime(post.body, lang) : 4;
        return (
          <a href={`/${lang}/blog/${post.slug.split('/').pop()}/`} class="group">
            <article class="card overflow-hidden hover-lift h-full flex flex-col">
              <div class="aspect-video overflow-hidden bg-surface-100 dark:bg-surface-800">
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
              <div class="p-5 flex-1 flex flex-col">
                <div class="flex items-center gap-2 mb-3">
                  <span class="badge text-xs">{t(lang, `categories.${post.data.category}`)}</span>
                  <span class="text-xs text-surface-500">
                    {formatReadingTime(readingTime, lang)}
                  </span>
                </div>
                <h2 class="text-lg font-bold text-surface-900 dark:text-surface-50 mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors line-clamp-2">
                  {post.data.title}
                </h2>
                <p class="text-sm text-surface-600 dark:text-surface-400 mb-4 line-clamp-2 flex-1">
                  {post.data.description}
                </p>
                <div class="pt-3 border-t border-surface-100 dark:border-surface-800">
                  <span class="text-xs text-surface-500">{formatDate(post.data.pubDate, lang)}</span>
                </div>
              </div>
            </article>
          </a>
        );
      })}
    </div>

    {sortedPosts.length === 0 && (
      <div class="text-center py-20">
        <p class="text-surface-500 dark:text-surface-500 text-lg">
          {t(lang, 'search.noResults')}
        </p>
      </div>
    )}
  </div>
</PageLayout>
