---
import BaseLayout from '@layouts/BaseLayout.astro';
import { locales, t, type Locale, getLangFromUrl } from '@i18n/utils';

const lang = getLangFromUrl(Astro.url) as Locale;
---

<BaseLayout title={t(lang, '404.title')}>
  <div class="min-h-screen flex items-center justify-center">
    <div class="text-center px-4">
      <!-- Big 404 -->
      <div class="text-[10rem] font-extrabold leading-none gradient-text select-none mb-4">
        404
      </div>

      <h1 class="text-3xl font-bold text-surface-900 dark:text-surface-50 mb-4">
        {t(lang, '404.title')}
      </h1>
      <p class="text-lg text-surface-600 dark:text-surface-400 mb-8 max-w-md mx-auto">
        {t(lang, '404.message')}
      </p>

      <a
        href={`/${lang}/`}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-primary-600 to-primary-500 hover:from-primary-700 hover:to-primary-600 text-white font-medium shadow-lg shadow-primary-500/25 hover:shadow-primary-500/40 transition-all"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rtl:rotate-180"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        {t(lang, '404.button')}
      </a>
    </div>
  </div>
</BaseLayout>
