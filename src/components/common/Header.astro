---
import { getLangFromUrl, t, getLocalizedUrl, type Locale, locales, languageInfo } from '@i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { key: 'nav.home', href: `/${lang}/` },
  { key: 'nav.blog', href: `/${lang}/blog/` },
  { key: 'nav.categories', href: `/${lang}/blog/` },
  { key: 'nav.about', href: `/${lang}/about/` },
  { key: 'nav.contact', href: `/${lang}/contact/` },
];
---

<header class="sticky top-0 z-40 w-full" id="main-header">
  <div class="glass border-b border-surface-200/50 dark:border-surface-700/50">
    <div class="container-custom">
      <nav class="flex items-center justify-between h-16 lg:h-18">
        <!-- Logo -->
        <a href={`/${lang}/`} class="flex items-center gap-2 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-primary-500 to-primary-700 flex items-center justify-center shadow-lg shadow-primary-500/25 group-hover:shadow-primary-500/40 transition-shadow">
            <span class="text-white font-bold text-sm">LN</span>
          </div>
          <span class="text-lg font-bold text-surface-800 dark:text-surface-100 hidden sm:inline">
            {t(lang, 'site.title')}
          </span>
        </a>

        <!-- Desktop Navigation -->
        <div class="hidden lg:flex items-center gap-1">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors
                ${currentPath === link.href || currentPath.startsWith(link.href + '/')
                  ? 'text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-900/20'
                  : 'text-surface-600 dark:text-surface-400 hover:text-surface-900 dark:hover:text-surface-100 hover:bg-surface-100 dark:hover:bg-surface-800'}`}
            >
              {t(lang, link.key)}
            </a>
          ))}
        </div>

        <!-- Right Actions -->
        <div class="flex items-center gap-2">
          <!-- Search Button -->
          <button
            id="search-trigger"
            class="p-2 rounded-lg text-surface-500 hover:text-surface-700 dark:text-surface-400 dark:hover:text-surface-200 hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors"
            aria-label={t(lang, 'nav.search')}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </button>

          <!-- Theme Toggle -->
          <button
            id="theme-toggle"
            class="p-2 rounded-lg text-surface-500 hover:text-surface-700 dark:text-surface-400 dark:hover:text-surface-200 hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors"
            aria-label={t(lang, 'theme.dark')}
          >
            <!-- Sun icon (shown in dark mode) -->
            <svg class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            <!-- Moon icon (shown in light mode) -->
            <svg class="block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </button>

          <!-- Language Switcher -->
          <div class="relative" id="lang-switcher">
            <button
              class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium text-surface-600 dark:text-surface-400 hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors"
              id="lang-trigger"
              aria-label={t(lang, 'lang.switch')}
            >
              <span class="text-base">{languageInfo[lang].flag}</span>
              <span class="hidden sm:inline text-xs">{languageInfo[lang].nativeName}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </button>

            <!-- Dropdown -->
            <div
              id="lang-dropdown"
              class="hidden absolute end-0 top-full mt-2 w-48 rounded-xl glass border border-surface-200 dark:border-surface-700 shadow-lg py-1 animate-scale-in"
            >
              {locales.map((locale) => {
                const targetPath = currentPath.replace(/^\/(ar|en|es|fr)/, `/${locale}`);
                return (
                  <a
                    href={targetPath}
                    class={`flex items-center gap-3 px-4 py-2.5 text-sm transition-colors
                      ${locale === lang
                        ? 'text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-900/20 font-medium'
                        : 'text-surface-600 dark:text-surface-400 hover:bg-surface-100 dark:hover:bg-surface-800'}`}
                  >
                    <span class="text-lg">{languageInfo[locale].flag}</span>
                    <span>{languageInfo[locale].nativeName}</span>
                    {locale === lang && (
                      <svg class="ms-auto" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                    )}
                  </a>
                );
              })}
            </div>
          </div>

          <!-- Mobile Menu Toggle -->
          <button
            id="mobile-menu-toggle"
            class="lg:hidden p-2 rounded-lg text-surface-500 hover:text-surface-700 dark:text-surface-400 dark:hover:text-surface-200 hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors"
            aria-label="Menu"
          >
            <svg id="menu-open-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
            <svg id="menu-close-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </div>
      </nav>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden glass border-b border-surface-200/50 dark:border-surface-700/50">
    <div class="container-custom py-4 space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`block px-4 py-3 rounded-lg text-sm font-medium transition-colors
            ${currentPath === link.href
              ? 'text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-900/20'
              : 'text-surface-600 dark:text-surface-400 hover:bg-surface-100 dark:hover:bg-surface-800'}`}
        >
          {t(lang, link.key)}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  // Theme toggle
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Language dropdown
  const langTrigger = document.getElementById('lang-trigger');
  const langDropdown = document.getElementById('lang-dropdown');
  
  langTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    langDropdown?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => {
    langDropdown?.classList.add('hidden');
  });

  // Search trigger
  document.getElementById('search-trigger')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-search'));
  });

  // Mobile menu
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOpenIcon = document.getElementById('menu-open-icon');
  const menuCloseIcon = document.getElementById('menu-close-icon');

  mobileToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden');
    menuOpenIcon?.classList.toggle('hidden');
    menuCloseIcon?.classList.toggle('hidden');
  });

  // Header scroll effect
  let lastScroll = 0;
  const header = document.getElementById('main-header');
  
  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    if (currentScroll > 100) {
      header?.classList.add('shadow-sm');
    } else {
      header?.classList.remove('shadow-sm');
    }
    lastScroll = currentScroll;
  });
</script>
