---
import { t, type Locale } from '@i18n/utils';

interface Props {
  lang: Locale;
  items: { label: string; href: string }[];
}

const { lang, items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-surface-500 dark:text-surface-500">
    <li>
      <a href={`/${lang}/`} class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
        {t(lang, 'breadcrumb.home')}
      </a>
    </li>
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rtl:rotate-180"><path d="m9 18 6-6-6-6"/></svg>
        {index === items.length - 1 ? (
          <span class="text-surface-800 dark:text-surface-200 font-medium">{item.label}</span>
        ) : (
          <a href={item.href} class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
            {item.label}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>
