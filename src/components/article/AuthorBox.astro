---
import { t, type Locale } from '@i18n/utils';

interface Props {
  name: string;
  avatar?: string;
  bio?: string;
  lang: Locale;
}

const { name, avatar, bio, lang } = Astro.props;
const initial = name.charAt(0);
---

<div class="card p-6 mt-10">
  <h4 class="text-xs font-semibold text-surface-500 dark:text-surface-500 uppercase tracking-wider mb-4">
    {t(lang, 'article.author')}
  </h4>
  <div class="flex items-start gap-4">
    {avatar ? (
      <img src={avatar} alt={name} class="w-14 h-14 rounded-full object-cover ring-2 ring-primary-200 dark:ring-primary-800" />
    ) : (
      <div class="w-14 h-14 rounded-full bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center text-white text-xl font-bold ring-2 ring-primary-200 dark:ring-primary-800">
        {initial}
      </div>
    )}
    <div class="flex-1">
      <h3 class="text-lg font-bold text-surface-900 dark:text-surface-50">
        {name}
      </h3>
      {bio && (
        <p class="text-sm text-surface-600 dark:text-surface-400 mt-1">
          {bio}
        </p>
      )}
    </div>
  </div>
</div>
