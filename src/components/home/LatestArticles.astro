---
import { t, type Locale } from '@i18n/utils';
import { formatDate } from '@utils/seo';
import { formatReadingTime, getReadingTime } from '@utils/reading-time';

interface Props {
  lang: Locale;
  posts: {
    slug: string;
    data: {
      title: string;
      description: string;
      image: string;
      pubDate: Date;
      category: string;
      author: { name: string };
    };
    body?: string;
  }[];
  isSidebar?: boolean;
}

const { lang, posts, isSidebar = false } = Astro.props;
---

<section class="container-custom py-12">
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-2xl font-bold text-surface-900 dark:text-surface-50">
      {t(lang, 'home.latest')}
    </h2>
    <a
      href={`/${lang}/blog/`}
      class="text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors inline-flex items-center gap-1"
    >
      {t(lang, 'home.viewAll')}
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rtl:rotate-180"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>

  <div class={`grid gap-6 animate-stagger ${isSidebar ? 'sm:grid-cols-1 md:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3'}`}>
    {posts.map((post) => {
      const readingTime = post.body ? getReadingTime(post.body, lang) : 4;
      return (
        <a href={`/${lang}/blog/${post.slug.split('/').pop()}/`} class="group">
          <article class="card overflow-hidden hover-lift h-full flex flex-col">
            <!-- Image -->
            <div class="aspect-video overflow-hidden bg-surface-100 dark:bg-surface-800">
              <img
                src={post.data.image}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>

            <!-- Content -->
            <div class="p-5 flex-1 flex flex-col">
              <div class="flex items-center gap-2 mb-3">
                <span class="badge text-xs">{t(lang, `categories.${post.data.category}`)}</span>
                <span class="text-xs text-surface-400 dark:text-surface-600">•</span>
                <span class="text-xs text-surface-500 dark:text-surface-500">
                  {formatReadingTime(readingTime, lang)}
                </span>
              </div>

              <h3 class="text-lg font-bold text-surface-900 dark:text-surface-50 mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors line-clamp-2">
                {post.data.title}
              </h3>

              <p class="text-sm text-surface-600 dark:text-surface-400 mb-4 line-clamp-2 flex-1">
                {post.data.description}
              </p>

              <div class="flex items-center gap-2 pt-4 border-t border-surface-100 dark:border-surface-800">
                <div class="w-6 h-6 rounded-full bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center text-white text-[10px] font-bold">
                  {post.data.author.name.charAt(0)}
                </div>
                <span class="text-xs text-surface-500 dark:text-surface-500">{post.data.author.name}</span>
                <span class="text-xs text-surface-400 dark:text-surface-600 ms-auto">{formatDate(post.data.pubDate, lang)}</span>
              </div>
            </div>
          </article>
        </a>
      );
    })}
  </div>
</section>
