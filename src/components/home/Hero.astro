---
import { t, type Locale } from '@i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<section class="relative overflow-hidden py-20 lg:py-28">
  <!-- Gradient Background -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary-50 via-white to-primary-100/50 dark:from-surface-950 dark:via-surface-950 dark:to-primary-950/20"></div>
  
  <!-- Decorative Blobs -->
  <div class="absolute top-10 start-10 w-72 h-72 bg-primary-200/30 dark:bg-primary-800/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-10 end-10 w-96 h-96 bg-primary-300/20 dark:bg-primary-700/10 rounded-full blur-3xl"></div>

  <div class="container-custom relative">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-100/80 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 text-sm font-medium mb-6 animate-fade-in">
        <span class="w-2 h-2 rounded-full bg-primary-500 animate-pulse"></span>
        {t(lang, 'site.title')}
      </div>

      <!-- Title -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold mb-6 animate-slide-up">
        <span class="gradient-text">{t(lang, 'hero.title')}</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-lg sm:text-xl text-surface-600 dark:text-surface-400 max-w-2xl mx-auto mb-10 animate-slide-up" style="animation-delay: 100ms">
        {t(lang, 'hero.subtitle')}
      </p>

      <!-- Search Bar -->
      <div class="max-w-lg mx-auto animate-slide-up" style="animation-delay: 200ms">
        <div class="relative group">
          <div class="absolute inset-0 bg-gradient-to-r from-primary-500 to-primary-400 rounded-2xl blur-lg opacity-20 group-hover:opacity-30 transition-opacity"></div>
          <div class="relative flex items-center bg-white dark:bg-surface-900 rounded-2xl border border-surface-200 dark:border-surface-700 shadow-xl shadow-surface-200/50 dark:shadow-surface-950/50 overflow-hidden">
            <svg class="ms-4 text-surface-400" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input
              type="text"
              placeholder={t(lang, 'hero.search.placeholder')}
              class="flex-1 px-4 py-4 bg-transparent text-surface-800 dark:text-surface-200 placeholder-surface-400 dark:placeholder-surface-600 focus:outline-none"
              id="hero-search-input"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
