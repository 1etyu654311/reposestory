---
import { t, type Locale } from '@i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<div class="card p-6 bg-gradient-to-br from-primary-600 to-primary-700 text-white relative overflow-hidden">
  <!-- Decorative Background -->
  <div class="absolute -top-10 -right-10 w-32 h-32 bg-white/10 rounded-full blur-2xl"></div>
  <div class="absolute -bottom-10 -left-10 w-24 h-24 bg-primary-400/20 rounded-full blur-xl"></div>

  <div class="relative z-10">
    <h3 class="text-xl font-bold mb-3">
      {t(lang, 'newsletter.title')}
    </h3>
    <p class="text-sm text-primary-100 mb-6">
      {t(lang, 'newsletter.subtitle')}
    </p>

    <form class="space-y-3">
      <input
        type="email"
        placeholder={t(lang, 'newsletter.placeholder')}
        required
        class="w-full px-4 py-2.5 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/60 focus:outline-none focus:ring-2 focus:ring-white/50 transition-all text-sm"
      />
      <button
        type="submit"
        class="w-full py-2.5 rounded-xl bg-white text-primary-700 font-bold text-sm shadow-xl shadow-primary-900/20 hover:bg-primary-50 transition-colors"
      >
        {t(lang, 'newsletter.button')}
      </button>
    </form>
    
    <p class="text-[10px] text-primary-200 mt-4 text-center opacity-80">
      We respect your privacy. Unsubscribe at any time.
    </p>
  </div>
</div>
